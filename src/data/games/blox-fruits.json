  "troubleshooting": [
    {
      "q": "Typo?",
      "a": "Codes are case-sensitive, so use the Copy button rather than typing them out."
    },
    {
      "q": "Already used?",
      "a": "Each code works once per account, and 2x Experience time stacks if you redeem several."
    },
    {
      "q": "Looking for the gift icon?",
      "a": "Older guides say to use a gift icon at the bottom left. That's been replaced by the Settings route above."
    },
    {
      "q": "Still failing?",
      "a": "The code has expired. Blox Fruits usually drops new ones with big updates and milestones."
    }
  ],
  "faq": [
    {
      "q": "Where do you redeem Blox Fruits codes now?",
      "a": "Gear icon on the left, then Settings, scroll to Gameplay, click Redeem next to Redeem DLC Code, and type into the Enter Promo Code box. The screenshots on this page show all three steps."
    },
    {
      "q": "Why do older guides say to use a gift icon?",
      "a": "That was the old route. The gift icon at the bottom left is gone, and codes now go through Settings. If a guide still shows the gift icon, it hasn't been checked in a while."
    },
    {
      "q": "Can I stack 2x Experience codes?",
      "a": "Yes. Redeeming several experience codes adds their time together, so you can build up a long boost before a grinding session."
    },
    {
      "q": "What's the fastest way to get 2x Experience?",
      "a": "GAMER_ROBOT_1M gives the most at 1 hour 30 minutes, then SUB2GAMERROBOT_EXP1 at 30 minutes. The rest give 20 minutes each, so redeeming them all in one go stacks up to several hours."
    },
    {
      "q": "Do stat reset codes cost anything?",
      "a": "No. KITT_RESET and Sub2UncleKizaru reset your stats for free, which normally costs in-game money, so they're worth saving until you actually want to rebuild your build."
    },
    {
      "q": "Why does fudd10 only give 1 Money?",
      "a": "It's a joke from the developers, as is Chandler at 0 Money. They work, they're just not worth rushing for."
    }
  ]
}
