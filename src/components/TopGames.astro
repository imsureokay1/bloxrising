---
import top from '../data/top-games.json';
import { formatDate } from '../lib/format';

const games = (top.games ?? []).slice(0, 10);
---
{games.length > 0 && (
  <section class="top" aria-labelledby="top-title">
    <div class="head">
      <h2 id="top-title">Top 10 games right now</h2>
      <p>Most players online across Roblox{top.updated ? `, checked ${formatDate(top.updated)}` : ''}.</p>
    </div>
    <ol>
      {games.map((g) => (
        <li>
          <a href={`/games/${g.slug}/`}>
            <span class="rank">{g.rank}</span>
            {g.icon
              ? <img src={g.icon} alt="" width="44" height="44" loading="lazy" />
              : <span class="blank" aria-hidden="true">{g.name.charAt(0)}</span>}
            <span class="info">
              <span class="name">{g.name}</span>
              <span class="meta">{g.players}{g.covered ? '' : ' · not covered yet'}</span>
            </span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .top { background: var(--ink); border-radius: 20px; padding: 22px 18px 8px; color: var(--ground); }
  .head h2 { color: var(--ground); }
  .head p { margin: 6px 0 10px; color: #B7BAC2; font-size: 14px; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid #2E3139; }
  li a { display: flex; align-items: center; gap: 12px; padding: 12px 0; color: var(--ground); min-height: 56px; }
  li a:hover { color: #fff; text-decoration: none; }
  .rank { font-family: var(--display); font-weight: 800; font-size: 20px; color: var(--green-bright); width: 24px; text-align: right; }
  img, .blank { width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0; object-fit: cover; }
  .blank { background: #2A2D35; display: flex; align-items: center; justify-content: center; font-family: var(--display); font-weight: 800; }
  .info { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .name { font-weight: 700; font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meta { font-size: 13px; color: #B7BAC2; }
  li a svg { color: #6B7280; flex-shrink: 0; }
</style>
