---
import { getCollection } from 'astro:content';
import { formatDate, tileColor } from '../lib/format';
import { kindLabel } from '../lib/kinds';

interface Props {
  // Slug of the game this page is about, so it isn't recommended back to itself.
  game?: string | null;
  // Guide id to leave out, when the current page is a guide.
  guide?: string | null;
}
const { game = null, guide = null } = Astro.props;

const allGames = await getCollection('games');

const games = allGames
  .filter((g) => g.id !== game)
  .sort((a, b) => (b.data.lastChecked ?? '').localeCompare(a.data.lastChecked ?? ''))
  .slice(0, 4);

const guides = (await getCollection('guides'))
  .filter((g) => g.id !== guide)
  .sort((a, b) => {
    // Guides for this game first, then the newest ones.
    const same = Number(b.data.game === game) - Number(a.data.game === game);
    return same || b.data.updated.getTime() - a.data.updated.getTime();
  })
  .slice(0, 4);

const gameName = (id: string) => allGames.find((g) => g.id === id)?.data.name ?? '';
---
{(games.length > 0 || guides.length > 0) && (
  <div class="more-reading">
    {games.length > 0 && (
      <section aria-labelledby="more-codes">
        <h2 id="more-codes">More codes</h2>
        <div class="list">
          {games.map((g) => {
            const active = g.data.codes.filter((c) => c.status === 'active').length;
            return (
              <a class="row list-card" href={`/codes/${g.id}/`}>
                {g.data.icon
                  ? <img src={g.data.icon} alt="" width="40" height="40" loading="lazy" />
                  : <span class="tile" style={`background:${tileColor(g.data.name)}`} aria-hidden="true">{g.data.name.charAt(0)}</span>}
                <span class="text">
                  <span class="name">{g.data.name} codes</span>
                  <span class="meta">
                    {active} active {active === 1 ? 'code' : 'codes'}
                    {g.data.lastChecked ? `, checked ${formatDate(g.data.lastChecked)}` : ''}
                  </span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {guides.length > 0 && (
      <section aria-labelledby="more-guides">
        <h2 id="more-guides">Guides you might like</h2>
        <div class="list">
          {guides.map((g) => (
            <a class="row list-card" href={`/guides/${g.id}/`}>
              <span class="text">
                <span class="kind">{gameName(g.data.game)} {kindLabel[g.data.kind].toLowerCase()}</span>
                <span class="name">{g.data.title}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
)}

<style>
  .more-reading { display: grid; gap: 28px; margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  @media (min-width: 760px) { .more-reading { grid-template-columns: 1fr 1fr; gap: 32px; } }
  h2 { font-size: 1.25rem; margin-bottom: 12px; }
  .list { display: flex; flex-direction: column; gap: 10px; }
  .row { display: flex; align-items: center; gap: 12px; padding: 14px; color: var(--ink); min-height: 56px; }
  .row:hover { border-color: var(--green); text-decoration: none; color: var(--ink); }
  img, .tile { width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0; object-fit: cover; }
  .tile { color: #fff; font-family: var(--display); font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-weight: 700; font-size: 16px; line-height: 1.3; }
  .meta { font-size: 13px; color: var(--muted); }
  .kind { font-size: 13px; font-weight: 700; color: var(--green); }
</style>
