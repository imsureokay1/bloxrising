---
import { site } from '../site.config';

interface Props {
  // "rect" = 336x280 box, "banner" = wide strip
  size?: 'rect' | 'banner';
  // The ad unit ID from AdSense (data-ad-slot). Optional until you're approved.
  slot?: string;
}
const { size = 'rect', slot = '' } = Astro.props;
const live = Boolean(site.adsenseClient && slot);
const preview = import.meta.env.DEV && !live;
---
{live && (
  <div class="ad">
    <ins
      class="adsbygoogle"
      style="display:block;width:100%"
      data-ad-client={site.adsenseClient}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
{preview && (
  <div class="ad" aria-hidden="true">
    <div class={`ad-placeholder ${size}`}>Ad slot preview (hidden on the live site)</div>
  </div>
)}
