---
import ads from '../data/ads.json';

interface Props {
  // Which ad unit, by its key in src/data/ads.json.
  name: keyof typeof ads.slots;
  // "rect" = 336x280 box, "banner" = wide strip (only affects the local preview box)
  size?: 'rect' | 'banner';
}
const { name, size = 'rect' } = Astro.props;
const slot = ads.slots[name] ?? '';
const live = Boolean(ads.client && slot);
const preview = import.meta.env.DEV && !live;
---
{live && (
  <div class="ad">
    <ins
      class="adsbygoogle"
      style="display:block;width:100%"
      data-ad-client={ads.client}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
{preview && (
  <div class="ad" aria-hidden="true">
    <div class={`ad-placeholder ${size}`}>Ad slot preview: {name} (hidden on the live site)</div>
  </div>
)}
