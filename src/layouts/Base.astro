---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  // Set on pages that are articles (guides, updates) so search engines get a date.
  updated?: Date | string | null;
  // The visible page heading, when it differs from the title tag.
  heading?: string | null;
  // Keep a page out of search results while it has nothing useful on it yet.
  noindex?: boolean;
}

const {
  title,
  description = site.tagline,
  image,
  updated = null,
  heading = null,
  noindex = false,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const isArticle = path.startsWith('/guides/') && path !== '/guides/';
const modified = updated ? new Date(updated).toISOString() : null;

// Breadcrumbs built from the URL, matching the ones shown on the page.
const segmentLabels: Record<string, string> = {
  codes: 'Codes',
  games: 'Games',
  guides: 'Guides',
  about: 'About',
  contact: 'Contact',
  privacy: 'Privacy Policy',
};
const segments = path.split('/').filter(Boolean);
const crumbs = [
  { name: 'Home', url: site.url + '/' },
  ...segments.map((seg, i) => ({
    name:
      i === segments.length - 1
        ? heading ?? title
        : segmentLabels[seg] ?? seg.replace(/-/g, ' '),
    url: new URL('/' + segments.slice(0, i + 1).join('/') + '/', site.url).href,
  })),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};

const articleSchema = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: heading ?? title,
      description,
      mainEntityOfPage: canonical,
      ...(modified ? { dateModified: modified } : {}),
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    }
  : null;

const siteSchema =
  path === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: site.url,
      }
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#15171C" />

    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image || '/logo-tile.png', site.url).href} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {modified && <meta property="article:modified_time" content={modified} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=JetBrains+Mono:wght@600;700&family=Public+Sans:wght@400;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>}
    {siteSchema && <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>}

    {site.adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
