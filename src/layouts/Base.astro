---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/bricolage-grotesque/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  // Set on guides so search engines get real dates. Leave published out when it isn't known.
  published?: Date | string | null;
  updated?: Date | string | null;
  // The visible page heading, when it differs from the title tag.
  heading?: string | null;
  // Keep a page out of search results while it has nothing useful on it yet.
  noindex?: boolean;
}

const {
  title,
  description = site.tagline,
  image,
  published = null,
  updated = null,
  heading = null,
  noindex = false,
} = Astro.props;
// Titles that already name the site (like the homepage's) don't get it twice.
const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const isArticle = path.startsWith('/guides/') && path !== '/guides/';
const modified = updated ? new Date(updated).toISOString() : null;
const publishedIso = published ? new Date(published).toISOString() : null;
const imageUrl = image ? new URL(image, site.url).href : null;

const author = { '@type': site.author.type, name: site.author.name, url: site.author.url };
const articleSchema = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: heading ?? title,
      description,
      mainEntityOfPage: canonical,
      ...(publishedIso ? { datePublished: publishedIso } : {}),
      ...(modified ? { dateModified: modified } : {}),
      ...(imageUrl ? { image: [imageUrl] } : {}),
      author,
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    }
  : null;

const siteSchema =
  path === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: site.url,
      }
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#15171C" />

    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl ?? new URL('/logo-tile.png', site.url).href} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {modified && <meta property="article:modified_time" content={modified} />}

    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>}
    {siteSchema && <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>}

    {site.adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
