---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap page">
    <h1>This page doesn't exist.</h1>
    <p class="lede">The game or guide may have moved. Try the full list of games instead.</p>
    <p><a class="btn" href="/codes/">See all games</a></p>
  </div>
</Base>
<style>.page { padding-top: 60px; } .page p { margin-top: 18px; }</style>
