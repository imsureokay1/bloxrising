---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButton from '../../components/ShareButton.astro';
import MoreReading from '../../components/MoreReading.astro';
import { site } from '../../site.config';
import { formatDate, tileColor } from '../../lib/format';
import { kindLabel } from '../../lib/kinds';
import top from '../../data/top-games.json';

export async function getStaticPaths() {
  const games = await getCollection('games');
  const covered = new Set(games.map((g) => g.id));
  const paths = games.map((game) => ({ params: { slug: game.id }, props: { game, listed: null } }));

  // Every game in the top 10 gets a page, even the ones we haven't written up yet.
  for (const entry of top.games ?? []) {
    if (!entry.slug || covered.has(entry.slug)) continue;
    covered.add(entry.slug);
    paths.push({ params: { slug: entry.slug }, props: { game: null, listed: entry } });
  }
  return paths;
}

interface Props {
  game: CollectionEntry<'games'> | null;
  listed: { name: string; players?: string; icon?: string | null; placeId?: string; rank?: number } | null;
}

const { game, listed } = Astro.props;

// Worked out up front, since expressions in the markup can't await.
const guides = game
  ? (await getCollection('guides'))
      .filter((g) => g.data.game === game.id)
      .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  : [];
const activeCodes = game ? game.data.codes.filter((c) => c.status === 'active') : [];
// Developer only shows when a person has filled it in for this game.
const byline = game
  ? [
      game.data.developer && `By ${game.data.developer}`,
      game.data.genre,
      game.data.released && `released ${formatDate(game.data.released)}`,
    ].filter(Boolean).join(', ')
  : '';
const guideCount = guides.length;
---
{listed && !game ? (
  <Base
    title={`${listed.name}: Player Count`}
    heading={listed.name}
    description={`${listed.name} is one of the most played Roblox games right now. We don't cover it yet.`}
    noindex={true}
  >
    <div class="wrap page">
      <Breadcrumbs items={[{ name: 'Games', href: '/games/' }, { name: listed.name }]} />

      <header class="hub-head">
        {listed.icon
          ? <img class="tile" src={listed.icon} alt="" width="72" height="72" />
          : <span class="tile blank" style={`background:${tileColor(listed.name)}`} aria-hidden="true">{listed.name.charAt(0)}</span>}
        <div class="titles">
          <h1>{listed.name}</h1>
          <p class="by">
            {listed.rank ? `#${listed.rank} by players online` : 'In the top 10 by players online'}
            {listed.players ? `, ${listed.players}` : ''}
          </p>
        </div>
        <div class="actions">
          {listed.placeId && (
            <a class="btn" href={`https://www.roblox.com/games/${listed.placeId}`} rel="noopener">Play on Roblox</a>
          )}
          <ShareButton title={listed.name} />
        </div>
      </header>

      <section class="card">
        <h2>We haven't covered this one yet</h2>
        <p>
          {listed.name} showed up in our top 10 by player count, so it has a page here. We just
          haven't written up its codes and guides yet.
        </p>
        <p>
          Games get covered fastest when people ask for them. If you play {listed.name} and want
          it covered, email <a href={`mailto:${site.email}`}>{site.email}</a> and it moves up the list.
        </p>
      </section>

      <AdSlot name="stub" size="rect" />

      <section class="card">
        <h2>Games we do cover</h2>
        <p>Codes, with where each one came from, plus guides and game info.</p>
        <p><a class="btn btn-ghost" href="/games/">See all games</a></p>
      </section>

      <MoreReading />
    </div>
  </Base>
) : null}

{game ? (
  <Base
    image={game.data.cover}
    heading={game.data.name}
    title={`${game.data.name}${game.data.altName ? ` (${game.data.altName})` : ''} on Roblox: Game Info and Guides`}
    description={`What ${game.data.name} is and how it plays${guideCount ? `, with ${guideCount} ${guideCount === 1 ? 'guide' : 'guides'}` : ''}, plus a link to the current codes.`}
  >
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Games', href: '/games/' }, { name: game.data.name }]} />

      {game.data.cover && (
        <img class="cover" src={game.data.cover} alt={`${game.data.name} cover art`} width="1200" height="675" />
      )}

      <header class="hub-head">
        {game.data.icon
          ? <img class="tile" src={game.data.icon} alt="" width="72" height="72" />
          : <span class="tile blank" style={`background:${tileColor(game.data.name)}`} aria-hidden="true">{game.data.name.charAt(0)}</span>}
        <div class="titles">
          <h1>{game.data.name}</h1>
          {game.data.altName && <p class="aka">Also called {game.data.altName}</p>}
          {byline && <p class="by">{byline}</p>}
        </div>
        <div class="actions">
          <a class="btn" href={game.data.robloxUrl} rel="noopener">Play on Roblox</a>
          <ShareButton title={game.data.name} />
        </div>
      </header>

      <nav class="jump" aria-label="On this page">
        {game.data.about && <a href="#about">About the game</a>}
        {guides.length > 0 && <a href="#guides">Guides</a>}
        <a href={`/codes/${game.id}/`}>Codes</a>
      </nav>

      <div class="hub-grid">
        <div class="main-col">
          {game.data.about && (
            <section id="about" class="section prose" aria-labelledby="about-title">
              <h2 id="about-title">About {game.data.name}</h2>
              {game.data.about.split(/\n\s*\n/).filter(Boolean).map((p) => <p>{p}</p>)}
            </section>
          )}

          {guides.length > 0 && (
            <section id="guides" class="section" aria-labelledby="guides-title">
              <h2 id="guides-title">Guides and news</h2>
              <div class="posts">
                {guides.map((p) => (
                  <a class="list-card post" href={`/guides/${p.id}/`}>
                    <span class="kind">{kindLabel[p.data.kind]}</span>
                    <span class="t">{p.data.title}</span>
                    <span class="desc">{p.data.description}</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="card codes-card" aria-labelledby="codes-title">
            <div class="card-head">
              <h2 id="codes-title">Codes</h2>
              {game.data.lastChecked
                ? <span class="checked">List reviewed {formatDate(game.data.lastChecked)}</span>
                : <span class="checked is-pending">Not reviewed yet</span>}
            </div>
            <p>
              {activeCodes.length === 0
                ? (game.data.codesNote ? game.data.codesNote.split(/\n\s*\n/)[0] : 'No active codes right now.')
                : `${activeCodes.length} active ${activeCodes.length === 1 ? 'code' : 'codes'}, with rewards, where each came from, and how to redeem them.`}
            </p>
            <a class="btn" href={`/codes/${game.id}/`}>{game.data.name} codes</a>
          </section>
        </div>

        <aside class="side-col">
          {game.data.quickFacts.length > 0 && (
            <section class="card facts" aria-labelledby="facts-title">
              <h2 id="facts-title">Quick facts</h2>
              <dl>
                {game.data.quickFacts.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
              </dl>
            </section>
          )}
          <AdSlot name="hubSide" size="rect" />
        </aside>
      </div>

      <MoreReading game={game.id} />
    </div>
  </Base>
) : null}

<style>
  .page { max-width: 760px; }
  .cover { width: 100%; height: auto; aspect-ratio: 16 / 9; max-height: 360px; object-fit: cover; border-radius: 20px; margin-top: 18px; }
  .hub-head { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; padding-top: 18px; }
  .tile { width: 72px; height: 72px; border-radius: 18px; object-fit: cover; flex-shrink: 0; }
  .tile.blank { color: #fff; font-family: var(--display); font-weight: 800; font-size: 34px; display: flex; align-items: center; justify-content: center; }
  .titles { flex: 1; min-width: 200px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .by { margin: 6px 0 0; color: var(--muted); }
  .aka { margin: 6px 0 0; font-weight: 600; color: var(--ink-2); }
  .jump { display: flex; gap: 8px; flex-wrap: wrap; margin: 24px 0 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .jump a { font-weight: 600; color: var(--ink); padding: 8px 14px; border-radius: 999px; background: var(--ground-2); min-height: 40px; display: inline-flex; align-items: center; }
  .jump a:hover { background: var(--ink); color: var(--ground); text-decoration: none; }
  .hub-grid { display: grid; gap: 0 32px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .hub-grid { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; } }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 20px; margin-top: 24px; }
  .card h2 { margin-bottom: 10px; }
  .card p { margin: 0 0 12px; line-height: 1.55; }
  .card-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .codes-card { border: 2px solid var(--ink); }
  .section { margin-top: 32px; }
  .section h2 { margin-bottom: 14px; }
  .posts { display: flex; flex-direction: column; gap: 10px; }
  .post { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; color: var(--ink); }
  .post:hover { border-color: var(--green); text-decoration: none; color: var(--ink); }
  .kind { font-size: 14px; font-weight: 700; color: var(--green); }
  .t { font-weight: 700; font-size: 17px; }
  .desc { color: var(--ink-2); font-size: 15px; }
  .facts h2 { font-size: 1.2rem; margin-bottom: 8px; }
  .facts dl { margin: 0; }
  .facts div { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-weight: 700; text-align: right; }
</style>
