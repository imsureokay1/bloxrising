---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GameRow from '../components/GameRow.astro';
import GameCard from '../components/GameCard.astro';
import TopGames from '../components/TopGames.astro';
import AdSlot from '../components/AdSlot.astro';
import { kindLabel } from '../lib/kinds';
import { site } from '../site.config';
import { formatDate, tileColor } from '../lib/format';

const games = await getCollection('games');
const recent = [...games]
  .sort((a, b) => (b.data.lastChecked ?? '').localeCompare(a.data.lastChecked ?? ''))
  .slice(0, 6);
const guides = (await getCollection('guides'))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 4);
const gameFor = (id: string) => games.find((g) => g.id === id);
const nameFor = (id: string) => gameFor(id)?.data.name ?? '';
// Guides can set their own thumbnail; otherwise the game's icon stands in.
const thumbFor = (g: (typeof guides)[number]) => g.data.image ?? gameFor(g.data.game)?.data.icon ?? null;
const featured = [...games]
  .sort((a, b) => (a.data.rising ?? 99) - (b.data.rising ?? 99) || a.data.name.localeCompare(b.data.name))
  .slice(0, 6);
---
<Base title={`${site.name}: Roblox Codes and Guides for Rising Games`} description={site.tagline}>
  <div class="hero">
    <div class="wrap">
      <h1>Rising games, spotted early.</h1>
      <p class="lede">Codes, beginner guides, and game info for Roblox games that are gaining players.</p>
      <form class="search" action="/codes/" method="get" role="search">
        <label for="q">Search a game</label>
        <input id="q" name="q" type="search" placeholder="Search a game, like Slayers 2" autocomplete="off" />
        <button class="btn" type="submit">Search</button>
      </form>
    </div>
  </div>

  <div class="wrap">
    <section class="section" aria-labelledby="games-title">
      <div class="section-head">
        <h2 id="games-title">Games we cover</h2>
        <a href="/games/">All games</a>
      </div>
      <div class="cards">
        {featured.map((g) => <GameCard game={g} />)}
      </div>
    </section>
  </div>

  <div class="wrap grid">
    <aside class="section side">
      <TopGames />
      <AdSlot name="home" size="rect" />
    </aside>

    <section class="section main" aria-labelledby="updated-title">
      <div class="section-head">
        <h2 id="updated-title">Latest codes</h2>
        <a href="/codes/">All games</a>
      </div>
      <div class="rows">
        {recent.map((g) => <GameRow game={g} />)}
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="section" aria-labelledby="guides-title">
      <div class="section-head">
        <h2 id="guides-title">New guides</h2>
        <a href="/guides/">All guides</a>
      </div>
      <div class="guides">
        {guides.map((g) => {
          const thumb = thumbFor(g);
          const name = nameFor(g.data.game);
          return (
            <a class="guide list-card" href={`/guides/${g.id}/`}>
              {thumb
                ? <img class="thumb" src={thumb} alt="" width="56" height="56" loading="lazy" />
                : <span class="thumb blank" style={`background:${tileColor(name || g.data.title)}`} aria-hidden="true">{(name || g.data.title).charAt(0)}</span>}
              <span class="kind">{name} {kindLabel[g.data.kind].toLowerCase()}</span>
              <span class="title">{g.data.title}</span>
              <span class="date">Updated {formatDate(g.data.updated)}</span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { padding: 44px 0 8px; }
  .hero h1 { max-width: 14ch; }
  .hero .search { margin-top: 22px; }
  /* On phones the top 10 comes first; on wide screens it sits in the sidebar. */
  .grid { display: grid; gap: 0 32px; grid-template-columns: 1fr; }
  @media (min-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; }
    .main { grid-column: 1; grid-row: 1; }
    .side { grid-column: 2; grid-row: 1; }
  }
  .rows { display: flex; flex-direction: column; gap: 10px; }
  .cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .guides { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .guide { display: flex; flex-direction: column; gap: 6px; padding: 18px; color: var(--ink); }
  .guide:hover { border-color: var(--green); text-decoration: none; color: var(--ink); }
  .thumb { width: 56px; height: 56px; border-radius: 14px; object-fit: cover; margin-bottom: 4px; }
  .thumb.blank { color: #fff; font-family: var(--display); font-weight: 800; font-size: 26px; display: flex; align-items: center; justify-content: center; }
  .kind { font-size: 14px; font-weight: 700; color: var(--green); }
  .title { font-weight: 700; font-size: 17px; line-height: 1.3; }
  .date { font-size: 14px; color: var(--muted); }
</style>
