---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Contact" description="Contact BloxRising for code tips, corrections, or sponsorships.">
  <div class="wrap prose page">
    <h1>Contact</h1>
    <p>For new codes, corrections, sponsorships, or developer questions, email us at:</p>
    <p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <p>Developers: if you'd like your game covered, include the game link and any codes you're launching with.</p>
  </div>
</Base>
<style>.page { padding-top: 36px; } .page h1 { margin-bottom: 18px; } .email { font-size: 1.3rem; font-weight: 700; }</style>
