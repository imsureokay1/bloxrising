---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButton from '../../components/ShareButton.astro';
import MoreReading from '../../components/MoreReading.astro';
import { site } from '../../site.config';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

interface Props { guide: CollectionEntry<'guides'> }
const { guide } = Astro.props;
const { Content } = await render(guide);
const game = (await getCollection('games')).find((g) => g.id === guide.data.game);
// The guide's own banner, or the game's cover art as a fallback.
const banner = guide.data.image ?? game?.data.cover ?? null;
const { tested, sources } = guide.data;
---
<Base
  title={guide.data.title}
  heading={guide.data.title}
  description={guide.data.description}
  published={guide.data.published}
  updated={guide.data.updated}
  image={banner}
>
  <div class="wrap">
    <Breadcrumbs items={game
      ? [
          { name: 'Games', href: '/games/' },
          { name: game.data.name, href: `/games/${game.id}/` },
          { name: guide.data.title },
        ]
      : [
          { name: 'Guides', href: '/guides/' },
          { name: guide.data.title },
        ]} />
    <article>
      {banner && (
        <img class="banner" src={banner} alt="" width="1200" height="480" fetchpriority="high" />
      )}
      <header class="head">
        <h1>{guide.data.title}</h1>
        <p class="byline">
          By {site.author.name}
          {guide.data.published && <> · Published {formatDate(guide.data.published)}</>}
          {' '}· Updated {formatDate(guide.data.updated)}
        </p>
        <div class={`sourcing${tested ? ' is-tested' : ''}`}>
          {tested
            ? <p><strong>Tested:</strong> we played through what this guide describes ourselves.</p>
            : <p><strong>Not tested by us yet.</strong> This guide is put together from other players' guides and videos, not our own play. Anything marked unconfirmed hasn't been checked by anyone we can point to.</p>}
          {sources.length > 0 && (
            <p>
              Sources:{' '}
              {sources.map((s, i) => (
                <>{i > 0 && ', '}{s.url ? <a href={s.url} rel="nofollow noopener">{s.name}</a> : s.name}</>
              ))}
            </p>
          )}
        </div>
        <p class="share-row"><ShareButton title={guide.data.title} /></p>
      </header>
      <div class="prose">
        <Content />
      </div>
      {game && (
        <p class="cta">
          <a class="btn" href={`/codes/${game.id}/`}>{game.data.name} codes</a>
          <a class="btn btn-ghost" href={`/games/${game.id}/`}>More {game.data.name} guides</a>
        </p>
      )}
      <AdSlot name="guideEnd" size="rect" />
      <MoreReading game={guide.data.game} guide={guide.id} />
    </article>
  </div>
</Base>

<style>
  .banner { width: 100%; height: auto; aspect-ratio: 5 / 2; object-fit: cover; border-radius: 20px; margin-top: 18px; }
  .head { padding-top: 22px; }
  .head h1 { max-width: 22ch; }
  .byline { color: var(--muted); margin: 10px 0 0; }
  .cta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px; }
  .share-row { margin: 14px 0 0; }
</style>
