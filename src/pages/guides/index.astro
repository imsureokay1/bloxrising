---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, tileColor } from '../../lib/format';
import { kindLabel } from '../../lib/kinds';

const games = await getCollection('games');
const guides = (await getCollection('guides')).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
const gameFor = (id: string) => games.find((g) => g.id === id);
// Guides can set their own thumbnail; otherwise the game's icon stands in.
const thumbFor = (guide: (typeof guides)[number]) =>
  guide.data.image ?? gameFor(guide.data.game)?.data.icon ?? null;
---
<Base title="Roblox Guides and News" description="Beginner guides, tier lists, updates, and spotlights for rising Roblox games.">
  <div class="wrap">
    <h1 class="title">Guides and news</h1>
    <p class="lede">Beginner guides, tier lists, updates, and spotlights for rising Roblox games.</p>
    <div class="list">
      {guides.map((g) => {
        const thumb = thumbFor(g);
        const name = gameFor(g.data.game)?.data.name ?? '';
        return (
          <a class="list-card item" href={`/guides/${g.id}/`}>
            {thumb
              ? <img class="thumb" src={thumb} alt="" width="64" height="64" loading="lazy" />
              : <span class="thumb blank" style={`background:${tileColor(name || g.data.title)}`} aria-hidden="true">{(name || g.data.title).charAt(0)}</span>}
            <span class="text">
              <span class="kind">{name} {kindLabel[g.data.kind].toLowerCase()}</span>
              <span class="t">{g.data.title}</span>
              <span class="desc">{g.data.description}</span>
              <span class="date">Updated {formatDate(g.data.updated)}</span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .title { padding-top: 36px; }
  .list { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; max-width: 760px; }
  .item { display: flex; align-items: flex-start; gap: 16px; padding: 18px; color: var(--ink); }
  .item:hover { border-color: var(--green); text-decoration: none; color: var(--ink); }
  .thumb { width: 64px; height: 64px; border-radius: 14px; object-fit: cover; flex-shrink: 0; }
  .thumb.blank { color: #fff; font-family: var(--display); font-weight: 800; font-size: 28px; display: flex; align-items: center; justify-content: center; }
  .text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .kind { font-size: 14px; font-weight: 700; color: var(--green); }
  .t { font-weight: 700; font-size: 18px; line-height: 1.3; }
  .desc { color: var(--ink-2); font-size: 15px; }
  .date { color: var(--muted); font-size: 14px; }
</style>
